                    end
                    if not err then
                        candidates[#candidates+1]={entity=e,key=key,original=original,part=part}
                        counts[key]=(counts[key] or 0)+1
                    end
                end
            end
            if err then warn('[KZBlockController] '..part:GetFullName()..': '..err) end
        end
    end
    for _,candidate in ipairs(candidates) do
        local e,key=candidate.entity,candidate.key
        if counts[key]~=1 or not candidate.original and known[e.id] then
            warn('[KZBlockController] Duplicate block ID rejected: '..key)
        elseif candidate.original then
            -- The original entity retains its filters, Source I/O, offsets,
            -- angles and per-player state. Its placed zone is not a second TP.
            Data.blockBindings[map][candidate.original.id]=candidate.part
        else Data.zones[#Data.zones+1]=e end
    end
end
function Data.addPracticeZones(map)
    if Data.practiceAdded==map then return end
    local folder=map:FindFirstChild("__KZ_BhopPractice")
    local origin=map:GetAttribute("KZPracticeOrigin")
    if not folder or not origin then return end
    Data.practiceAdded=map
    local name="__KZ_PracticeStart"
    Data.byName[name]={id=name,origin={origin.X,origin.Y,origin.Z},angles={0,0,0},
        properties={targetname=name,classname="info_teleport_destination"},class="info_teleport_destination"}
    for _,part in ipairs(folder:GetChildren()) do
        local kind=part:GetAttribute("KZBhopType")
        local a,b=part:GetAttribute("KZSourceBoundsMin"),part:GetAttribute("KZSourceBoundsMax")
        if kind and a and b then
            Data.zones[#Data.zones+1]={id="practice_"..part.Name,class="trigger_multiple",triggerType=kind,
                bounds={{a.X,a.Y,a.Z},{b.X,b.Y,b.Z}},properties={startdisabled="0",
                timer_teleport_delay=tostring(part:GetAttribute("KZBhopDelay") or .1),
                timer_teleport_destination=name,timer_teleport_reset_speed="1"},connections={}}
        end
    end
    Data.zones[#Data.zones+1]={id="practice_catch",class="trigger_multiple",triggerType=10,
        bounds={{origin.X-128,-160,-112},{origin.X+1008,544,-90}},properties={startdisabled="0",
        timer_teleport_delay="0",timer_teleport_destination=name,timer_teleport_reset_speed="1"},connections={}}
end
return Data
