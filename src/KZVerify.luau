-- Studio Command Bar in PLAY CLIENT context; read-only.
local function run()
    local player=game:GetService('Players').LocalPlayer
    assert(player,'Select Client context in Play first')
    local character=assert(player.Character,'Character missing')
    local root=assert(character:FindFirstChild('HumanoidRootPart'),'Root missing')
    local hull=assert(character:FindFirstChild('KZSourceHull'),'Source hull missing: check server Output')
    local unit=root:GetAttribute('KZStudsPerCSUnit')
    assert(unit,'Movement telemetry missing')
    print('Build/backend',root:GetAttribute('KZMovementBuild'),root:GetAttribute('KZMovementBackend'))
    print('Fallback reason',player:GetAttribute('KZBrushFallbackReason'))
    print('Profile',root:GetAttribute('KZMovementProfile'),'stud/unit',unit)
    print('Geometry',root:GetAttribute('KZBrushCount'),'primitive brushes +',root:GetAttribute('KZBrushMeshQueryCount'),'native mesh queries')
    print('Bound original zones',root:GetAttribute('KZBoundSourceZoneCount'))
    print('Speed CS units/s',root:GetAttribute('KZSpeedUnits'),'pre gain',root:GetAttribute('KZPreGainUnits') or root:GetAttribute('KZPreBonusUnits'))
    print('Hull height units',root:GetAttribute('KZVirtualHullHeightUnits'),'replicated hull size',hull.Size)
    print('Ground/surf',root:GetAttribute('KZGrounded'),root:GetAttribute('KZSurfing'),root:GetAttribute('KZSurfNormal'),root:GetAttribute('KZSurfPart'))
    print('Corrections',root:GetAttribute('KZGroundCorrections'),'ground;',root:GetAttribute('KZSeamRecoveries'),'seam recoveries')
    print('Water',root:GetAttribute('KZInWater'),'vertical units/s',root:GetAttribute('KZWaterVerticalUnits'))
    print('Conveyor units/s',root:GetAttribute('KZConveyorSpeedUnits'))
    print('Ladder',root:GetAttribute('KZOnLadder'),'id',root:GetAttribute('KZLadderId'))
    print('Source position',root:GetAttribute('KZSourcePosition'))
    print('Last jump',root:GetAttribute('KZLastJumpType'),root:GetAttribute('KZLastJumpDistanceUnits'),root:GetAttribute('KZLastJumpValid'),root:GetAttribute('KZLastJumpInvalidReason'))
    print('Timer',player:GetAttribute('KZRunState'),'CP',player:GetAttribute('KZCheckpointCount'),'TP',player:GetAttribute('KZTeleportCount'))
    print('Native mesh collisions, visible water edges and two-client replication still require a Studio playtest.')
end
return {run=run}
